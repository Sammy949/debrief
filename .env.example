# Copy to .env.local and fill in. Never commit the filled file.

# Required. Groq API key for the AI turns: https://console.groq.com
GROQ_API_KEY=

# Optional. Site analytics: the full URL of the tracker script, and the site id
# it reports under. Leave both blank to run Debrief with no analytics at all.
ANALYTICS_SRC=
ANALYTICS_WEBSITE_ID=
